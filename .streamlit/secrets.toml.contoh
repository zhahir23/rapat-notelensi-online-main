# SALIN file ini jadi "secrets.toml" (hapus akhiran .contoh), lalu isi nilainya.
# File secrets.toml TIDAK BOLEH di-upload ke GitHub.

# Kunci enkripsi. Kosongkan saja saat pertama kali — aplikasi akan membuat
# file secret.key otomatis. Isi di sini hanya kalau nanti deploy online.
# GOVSCRIBE_KEY = ""

# Akun Gmail pengirim OTP. Wajib App Password 16 digit, bukan password akun.
SMTP_EMAIL = "govscribe.bot@gmail.com"
SMTP_PASSWORD = "abcdefghijklmnop"

# Identitas yang tampil di email
NAMA_INSTANSI = "Sekretariat Daerah"
ALAMAT_INSTANSI = "Jl. Raya Pemerintahan No. 1"
